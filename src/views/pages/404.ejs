<%
const pageTitle = title;
%>

<!-- 404 Hero -->
<section class="page-hero" style="min-height: 60vh;">
  <div class="container">
    <h1 class="page-hero-title" style="font-size: var(--text-7xl);">404</h1>
    <p class="page-hero-subtitle"><%= lang === 'vi' ? 'Trang bạn đang tìm kiếm không tồn tại.' : 'The page you are looking for does not exist.' %></p>
    <div style="margin-top: var(--space-8);">
      <a href="/?lang=<%= lang %>" class="btn btn-white btn-lg">
        <%= lang === 'vi' ? 'Về trang chủ' : 'Go Home' %>
      </a>
    </div>
  </div>
</section>
